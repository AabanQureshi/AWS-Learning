<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AWS Learning</title>
    <link rel="stylesheet" href="~/css/lab.css" asp-append-version="true" />
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
        <a class="brand" asp-controller="Document" asp-action="Index"><span class="brand-mark" aria-hidden="true">a/</span><span>AWS Learning<small>THE DOCUMENT LAB</small></span></a>
        <nav aria-label="Main navigation"><a asp-controller="Document" asp-action="Index">New upload</a><a asp-controller="Document" asp-action="Index" asp-fragment="find-job">Find a job</a></nav>
        <span class="environment-label"><span aria-hidden="true">●</span> Local learning lab</span>
    </header>
    <main id="main-content" class="lab-shell">@RenderBody()</main>
    <footer class="site-footer"><span>Learn by following the request.</span><span>.NET 10 / S3 / DynamoDB / SQS</span></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
